<odoo>
  <data>
<!--Lista Definición-->
    <record model="ir.ui.view" id="proveedor_list">
      <field name="name">proveedor list</field>
      <field name="model">new_climb.proveedor</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="direccion"/>
          <field name="telefono"/>
          <field name="email"/>
        </list>
      </field>
    </record>

  <!--Vista de búsqueda: barra de buscar, filtros y agrupar por-->
    <record model="ir.ui.view" id="proveedor_search">
      <field name="name">proveedor search</field>
      <field name="model">new_climb.proveedor</field>
      <field name="arch" type="xml">
        <search string="Buscar proveedores">
          <field name="name"/>
          <field name="email"/>
          <field name="telefono"/>
          <separator/>
          <filter name="filtro_activo" string="Activos"
                  domain="[('actividad', '=', 'activo')]"/>
          <filter name="filtro_inactivo" string="Inactivos"
                  domain="[('actividad', '=', 'inactivo')]"/>
          <separator/>
          <filter name="filtro_ropa" string="Ropa"
                  domain="[('tipo', '=', 'ropa')]"/>
          <filter name="filtro_tecnico" string="Material técnico"
                  domain="[('tipo', '=', 'material_tecnico')]"/>
          <filter name="agrupar_tipo" string="Tipo de proveedor"
                  context="{'group_by': 'tipo'}"/>
          <filter name="agrupar_estado" string="Estado"
                  context="{'group_by': 'actividad'}"/>
        </search>
      </field>
    </record>

 <!--Acciones para abrir la vista de lista y formulario-->
    <record model="ir.actions.act_window" id="proveedor_action_window">
      <field name="name">Proveedores</field>
      <field name="res_model">new_climb.proveedor</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="proveedor_search"/>
    </record>

  <!--Vista de formulario-->
    <record model="ir.ui.view" id="proveedor_form">
      <field name="name">proveedor form</field>
      <field name="model">new_climb.proveedor</field>
      <field name="arch" type="xml">
        <form string="Proveedor Form">
          <sheet>
            <group>
              <field name="name"/>
              <field name="direccion"/>
              <field name="telefono"/>
              <field name="email"/>
              <field name="website"/>
              <field name="actividad"/>
              <field name="tipo"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
  <!--Menu items-->
    <menuitem name="New Climb" id="new_climb.menu_root"/>

  <!--Menu items hijos-->
    <menuitem name="Proveedores" id="proveedor_menu_1" parent="new_climb.menu_root"/>

  <!--Acciones de menu-->
    <menuitem name="Proveedores" id="proveedor_menu_1_list" parent="proveedor_menu_1"
              action="proveedor_action_window"/>
  </data>
</odoo>