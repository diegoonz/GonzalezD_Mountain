<odoo>
    <data>
    <!--Lista Definición-->
        <record model="ir.ui.view" id="alquiler_list">
            <field name="name">alquiler list</field>
            <field name="model">new_climb.alquiler</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="fecha_alquiler"/>
                    <field name="material_id" widget="many2many_tags"/>
                    <field name="proveedor_id"/>
                    <field name="cliente_id"/>
                    <field name="fecha_devolucion"/>
                    <field name="dias_alquiler"/>
                    <field name="fecha_devolucion_prevista"/>
                    <field name="precio_total"/>
                </list>
            </field>
        </record>

    <!--Vista de formulario-->
        <record model="ir.ui.view" id="alquiler_form">
            <field name="name">alquiler form</field>
            <field name="model">new_climb.alquiler</field>
            <field name="arch" type="xml">
                <form string="Alquiler">
                    <sheet>
                        <!--nombre del alquiler como título (es obligatorio en el modelo)-->
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Ej.: Alquiler vía ferrata Riglos"/></h1>
                        </div>
                        <group>
                            <group string="Quién y qué">
                                <field name="cliente_id"/>
                                <field name="proveedor_id"/>
                                <field name="material_id" widget="many2many_tags"/>
                            </group>
                            <group string="Fechas y precio">
                                <field name="fecha_alquiler"/>
                                <field name="dias_alquiler"/>
                                <field name="fecha_devolucion"/>
                                <field name="fecha_devolucion_prevista"/>
                                <field name="precio_total"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    <!--Vista de búsqueda: barra de buscar, filtros y agrupar por-->
        <record model="ir.ui.view" id="alquiler_search">
            <field name="name">alquiler search</field>
            <field name="model">new_climb.alquiler</field>
            <field name="arch" type="xml">
                <search string="Buscar alquileres">
                    <field name="name"/>
                    <field name="cliente_id"/>
                    <field name="material_id"/>
                    <separator/>
                    <filter name="filtro_fecha_alquiler" string="Fecha de alquiler"
                            date="fecha_alquiler"/>
                    <filter name="agrupar_cliente" string="Cliente"
                            context="{'group_by': 'cliente_id'}"/>
                    <filter name="agrupar_mes" string="Mes de alquiler"
                            context="{'group_by': 'fecha_alquiler:month'}"/>
                </search>
            </field>
        </record>

    <!--Acciones para abrir la vista de lista y formulario-->
        <record model="ir.actions.act_window" id="alquiler_action_window">
            <field name="name">Alquileres</field>
            <field name="res_model">new_climb.alquiler</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="alquiler_search"/>
        </record>

    <!--Menu hijos (primero el padre, después el que abre la acción)-->
        <menuitem name="Alquileres" id="alquiler_menu_1" parent="new_climb.menu_root"/>

    <!--Acciones de menu-->
        <menuitem name="Alquileres" id="alquiler_menu_1_list" parent="alquiler_menu_1"
                  action="alquiler_action_window"/>
    </data>
</odoo>