<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Vista de lista -->
    <record id="vista_lista_materiales" model="ir.ui.view">
        <field name="name">new_climb.material.list</field>
        <field name="model">new_climb.material</field>
        <field name="arch" type="xml">
            <list string="materiales">
                <field name="name"/>
                <field name="numero_serie"/>
                <field name="proveedor_id"/>
                <field name="actividad"/>
                <field name="precio_alquiler"/>
                <field name="cliente_id"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="vista_formulario_materiales" model="ir.ui.view">
        <field name="name">new_climb.material.form</field>
        <field name="model">new_climb.material</field>
        <field name="arch" type="xml">
            <form string="Material">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="numero_serie"/>
                        <field name="proveedor_id"/>
                        <field name="actividad"/>
                        <field name="precio_alquiler"/>
                        <field name="foto"/>
                        <field name="cliente_id"/>
                        <field name="revision_ids"/>
                    </group>
                </sheet>
            </form>   
        </field>
    </record> 

        <!-- Vista de busqueda -->
<record id="vista_busqueda_materiales" model="ir.ui.view">
    <field name="name">new_climb.materiales.search</field>
    <field name="model">new_climb.material</field>
    <field name="arch" type="xml">
        <search string = "Buscar materiales">
            <field name="cliente_id"/>
            <field name="revision_ids"/>
            <field name="actividad"/>
            <field name="proveedor_id"/>
           
            <filter name="Disponibles"
                    string="Materiales disponibles"
                    domain="[('actividad', '=', 'disponible')]"/>

            <group>
                <filter name="agrupar_actividad" string="Actividades"
                            context="{'group_by': 'actividad'}"/>
            </group>
            
        </search>
    </field>
</record>

     
    <!-- Acción -->
    <record id="accion_materiales" model="ir.actions.act_window">
        <field name="name">Materiales</field>
        <field name="res_model">new_climb.material</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="vista_busqueda_materiales"/>
    </record>
    <!-- Menú -->
    <menuitem id="menu_new_climb_materiales"
          name="Materiales"
          parent="new_climb.menu_root"
          action="accion_materiales"/>
</odoo>